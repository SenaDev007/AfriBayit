# ─── AfriBayit — Full-Stack Environment Variables ─────────────────────────
# This is now a full-stack monorepo (frontend + backend API routes).
# Copy this file to .env and fill in your values.

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── NextAuth (REQUIRED in production) ───────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ─── Redis (Upstash) ─────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── OAuth Providers (CDC §4.1) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── JWT RS256 (optional — falls back to HS256 if not set) ───────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Payments — FedaPay (Mobile Money UEMOA) ─────────────────────────────
FEDAPAY_API_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_SANDBOX=true
FEDAPAY_ENVIRONMENT=sandbox

# ─── Payments — Stripe (International cards) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Cloudflare R2 (File Storage) ────────────────────────────────────────
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=afribayit
R2_PUBLIC_URL=https://cdn.afribayit.com

# ─── Pusher (Realtime) ───────────────────────────────────────────────────
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
PUSHER_APP_ID=
PUSHER_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── SMS (Africa's Talking) ──────────────────────────────────────────────
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_BASE_URL=

# ─── WhatsApp Business ───────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── Push Notifications (Web Push / VAPID) ───────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Elasticsearch (Search) ──────────────────────────────────────────────
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# ─── OTA Integrations (Hospitality) ──────────────────────────────────────
BOOKING_COM_API_KEY=
BOOKING_COM_HOTEL_ID=
BOOKING_COM_WEBHOOK_SECRET=
EXPEDIA_API_KEY=
EXPEDIA_API_SECRET=
EXPEDIA_HOTEL_ID=
EXPEDIA_WEBHOOK_SECRET=
OTA_SANDBOX_MODE=true

# ─── Maps ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Sentry (Error Tracking) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ─── Encryption ──────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─── Cron Jobs ───────────────────────────────────────────────────────────
CRON_SECRET=

# ─── i18n — Fixer.io (FX rates, optional) ────────────────────────────────
NEXT_PUBLIC_FIXER_API_KEY=
