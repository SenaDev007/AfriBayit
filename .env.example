# ─── AfriBayit Frontend — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values

# ─── Backend API URL (NestJS on Railway) ─────────────────────────────────
# Development: http://localhost:3001
# Production: https://afribayit-api-xxxx.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── App URL ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── NextAuth (shared secret with backend) ───────────────────────────────
# ⚠️  REQUIRED in production. The app WILL return HTTP 500 on every authed
#    request if this is missing in production. In dev, an ephemeral
#    in-memory secret is used (with a console warning).
# Must match NEXTAUTH_SECRET on the backend (Railway).
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth Providers ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple Sign-In (CDC §4.1) — only registered if both are set
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Mapbox (frontend maps) ──────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
# Google Maps JS API key (used for Places/Geocoding fallback)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Fixer API (currency exchange rates) ─────────────────────────────────
NEXT_PUBLIC_FIXER_API_KEY=

# ─── Sentry (frontend error tracking) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ─── Pusher (frontend realtime — client keys only) ───────────────────────
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Note: Backend secrets (DATABASE_URL, STRIPE, FEDAPAY, R2, REDIS, SMS, etc.)
# are configured on Railway, NOT on the frontend.
