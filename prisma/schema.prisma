// ============ CHAT / REBECCA IA ============

model Conversation {
  id        String   @id @default(cuid())
  type      String   @default("rebecca") // rebecca, user_to_user, support
  status    String   @default("active") // active, closed, archived
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String    @default("participant") // participant, admin
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    String   @default("text") // text, property_card, image, file, system, quick_reply
  metadata       Json?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt]) // P2.3 — chat history
  @@index([senderId, createdAt]) // P2.3 — user's sent messages
  @@index([conversationId], map: "ChatMessage_conversationId_idx")
  @@map("chat_messages")
}

