model HotelRoom {
  id           String   @id @default(cuid())
  hotelId      String
  type         String // single, double, suite, deluxe, family
  name         String?
  capacity     Int      @default(2)
  amenities    Json?
  basePriceXof Float
  currency     String   @default("XOF")
  photos       Json?
  totalRooms   Int      @default(1)
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())

  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  availability RoomAvailability[]
  channelItems ChannelInventory[]

  @@map("hotel_rooms")
}

model RoomAvailability {
  id            String   @id @default(cuid())
  roomId        String
  date          DateTime
  status        String   @default("AVAILABLE") // AVAILABLE, BOOKED, BLOCKED, MAINTENANCE
  priceOverride Float?
  currency      String   @default("XOF")
  source        String   @default("manual") // manual, ota_booking, channel_manager
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@map("room_availability")
}

model HotelBooking {
  id              String   @id @default(cuid())
  bookingRef      String?  @unique
  hotelId         String
  roomId          String?
  userId          String
  checkIn         DateTime
  checkOut        DateTime
  guests          Int      @default(1)
  totalPrice      Float
  currency        String   @default("XOF")
  sourceChannel   String   @default("direct") // direct, booking_com, expedia, guesthouse
  status          String   @default("pending") // pending, confirmed, checked_in, completed, cancelled, no_show
  paymentRef      String?
  paymentProvider String?
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel  Hotel        @relation(fields: [hotelId], references: [id])
  user   User         @relation(fields: [userId], references: [id])
  review HotelReview?

  deletedAt DateTime?

  @@index([userId], map: "HotelBooking_userId_idx")
  @@index([hotelId, checkIn], map: "HotelBooking_hotel_checkIn_idx")
  @@map("hotel_bookings")
}

model HotelReview {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  hotelId     String
  userId      String
  cleanliness Int? // 1-5
  comfort     Int? // 1-5
  location    Int? // 1-5
  value       Int? // 1-5
  service     Int? // 1-5
  overall     Int // 1-5
  comment     String?
  response    String?
  respondedAt DateTime?
  status      String    @default("published") // pending_moderation, published, hidden
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking HotelBooking @relation(fields: [bookingId], references: [id])
  hotel   Hotel        @relation(fields: [hotelId], references: [id])

  deletedAt DateTime?

  @@map("hotel_reviews")
}

model OtaSyncLog {
  id           String   @id @default(cuid())
  hotelId      String
  ota          String // booking_com, expedia
  operation    String // PUSH, PULL
  status       String   @default("pending") // pending, success, failed
  payload      Json?
  errorMessage String?
  executedAt   DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("ota_sync_logs")
}

model ChannelInventory {
  id             String   @id @default(cuid())
  roomId         String
  hotelId        String
  ota            String // booking_com, expedia, direct
  availableCount Int      @default(0)
  rateXof        Float?
  rateEur        Float?
  lastSyncedAt   DateTime @default(now())

  room  HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotel Hotel     @relation("HotelChannelInventory", fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("channel_inventory")
}

