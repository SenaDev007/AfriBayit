// AfriBayit — Prisma Schema V2
// Plateforme Immobilière Pan-Africaine de Nouvelle Génération
// Complet selon CDC V3.1 — Toutes sections intégrées

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS — typed statuses (Phase B/C cutover complete) ============
// The legacy String status columns have been converted to enum types.
// Values match the actual values used in application code.
// The *Enum columns have been dropped — the main `status` column IS the enum.

enum PropertyStatus {
  draft
  pending
  pending_validation
  ai_review
  human_review
  published
  sold
  rented
  rejected
  flagged
}

enum TransactionStatus {
  CREATED
  FUNDED
  DOCS_VALIDATED
  GEOTRUST_VALIDATED
  GEO_VERIFIED
  NOTARY_ASSIGNED
  NOTARY_IN_PROGRESS
  DEED_SIGNED
  ANDF_REGISTERED
  RELEASED
  DISPUTED
  DISPUTED_MEDIATION
  REFUNDED
  CANCELLED
  PARTIAL_RELEASE
  PENDING
}

enum EscrowState {
  EMPTY
  FUNDED
  PARTIAL_RELEASE
  FULL_RELEASE
  REFUNDED
  DISPUTED
  NOTARY_IN_PROGRESS
  DISPUTED_MEDIATION
}

enum KycStatus {
  pending
  approved
  ai_validated
  human_validated
  rejected
  expired
}

enum KycLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

// ============ USERS & AUTH ============

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  phone                   String?   @unique
  name                    String
  firstName               String?
  lastName                String?
  avatar                  String?
  coverPhoto              String?
  password                String?
  role                    String    @default("buyer") // buyer, seller, investor, tourist, artisan, agent, notary, geometer, admin, hotelier, trainer, certified_agent, premium_agent, artisan_pro
  country                 String? // BJ, CI, BF, TG
  city                    String?
  kycLevel                Int       @default(0) // 0=Anonyme, 1=Standard, 2=Avancé, 3=Pro
  /// P2.4 — typed KYC level (new column; legacy `kycLevel: Int` remains in place)
  kycLevelEnum            KycLevel  @default(LEVEL_0)
  score                   Int       @default(0) // 0-1000 reputation score
  reputation              String    @default("Decouvreur") // Decouvreur, Acteur, Expert, Ambassadeur
  bio                     String?
  specialties             Json?
  emailVerified           DateTime? // When email was verified (null = not verified)
  phoneVerified           DateTime? // When phone was verified (null = not verified)
  verified                Boolean   @default(false)
  verificationStatus      String    @default("PENDING") // PENDING, APPROVED, REJECTED — agent certification status
  premiumTier             String? // starter, essentiel, avance, elite
  premiumExpiry           DateTime?
  walletBalance           Decimal   @default(0) @db.Decimal(19, 4)
  escrowHeld              Decimal   @default(0) @db.Decimal(19, 4)
  pendingPayout           Decimal   @default(0) @db.Decimal(19, 4)
  afriPoints              Int       @default(0)
  credibilityScore        Int       @default(0) // 0-100 score de crédibilité profil LinkedIn-like
  isOnline                Boolean   @default(false)
  lastSeenAt              DateTime?
  twoFactorEnabled        Boolean   @default(false)
  twoFactorSecret         String?
  preferredLanguage       String    @default("fr") // fr, en, sw, ha, wo, ar
  currency                String    @default("XOF") // XOF, EUR, USD, NGN, GHS, KES
  dateOfBirth             DateTime?
  notificationPreferences Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  properties              Property[]
  transactions            Transaction[]
  listings                AgentListing[]
  reviews                 Review[]
  courses                 CourseEnrollment[]
  posts                   CommunityPost[]
  notifications           Notification[]
  oauthAccounts           OAuthAccount[]
  kycDocuments            KycDocument[]
  pushSubscriptions       PushSubscription[]
  walletTxns              WalletTransaction[]
  subscriptions           Subscription[]
  professionalProfile     ProfessionalProfile?
  endorsements            SkillEndorsement[]
  sentMessages            ChatMessage[]             @relation("SentMessages")
  conversations           ConversationParticipant[]
  appointments            Appointment[] // P2.9 — visitor appointments
  favorites               Favorite[]
  profileViews            ProfileView[]             @relation("ProfileViewed")
  viewerProfiles          ProfileView[]             @relation("ProfileViewer")
  connections             UserConnection[]          @relation("Requester")
  connectedTo             UserConnection[]          @relation("Target")
  hotelBookings           HotelBooking[]
  guesthouseBookings      GuesthouseBooking[]
  shortTermRentalBookings ShortTermRentalBooking[]
  accreditations          CountryAccreditation[]
  quizAttempts            QuizAttempt[]
  certificates            Certificate[]
  afriPointTxns           AfriPointTransaction[]
  ambassador              Ambassador?
  notary                  Notary?
  geometer                Geometer?
  following               Follower[]                @relation("Following")
  followers               Follower[]                @relation("Followers")
  groupMemberships        GroupMembership[]
  replies                 CommunityReply[]
  artisanProfile          Artisan?
  notarySignatures        NotarySignature[] // P2.2 — inverse relation
  disputesInitiated       Dispute[] // P2.2 — inverse relation

  deletedAt DateTime?

  @@map("users")
}

model OAuthAccount {
  id           String   @id @default(cuid())
  provider     String // google, facebook, apple
  providerId   String
  userId       String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model KycDocument {
  id              String    @id @default(cuid())
  userId          String
  docType         String // id_card, passport, selfie, proof_address, income_source, rccm, company_statutes, agent_license, notary_license, geometer_license, business_reg
  docUrl          String
  ocrResult       Json?
  ocrValid        Boolean   @default(false)
  aiScore         Float? // 0-100 AI validation score
  status          KycStatus @default(pending)
  rejectionReason String?
  country         String? // BJ, CI, BF, TG
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([userId, status]) // P2.3 — admin KYC queue
  @@index([country, status]) // P2.3 — tenant-scoped KYC lookup
  @@index([createdAt])
  @@map("kyc_documents")
}

// ============ PUSH SUBSCRIPTIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ============ OTP VERIFICATION ============

model OtpVerification {
  id         String   @id @default(cuid())
  identifier String // phone or email
  code       String // 6-digit OTP code
  type       String // phone, email
  verified   Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, code])
  @@map("otp_verifications")
}

// ============ PROPERTIES ============

model Property {
  id              String                                @id @default(cuid())
  title           String
  slug            String?                               @unique
  type            String // villa, appartement, terrain, bureau, commerce, chambre, guesthouse
  transaction     String // achat, location, investissement, location_courte_duree
  price           Float
  currency        String                                @default("XOF")
  surface         Float
  rooms           Int                                   @default(0)
  bedrooms        Int                                   @default(0)
  bathrooms       Int                                   @default(0)
  city            String
  country         String
  quartier        String
  address         String?
  description     String
  features        Json?
  images          Json?
  lat             Float?
  lng             Float?
  /// PostGIS geometry field — requires PostGIS extension. Use createPoint() from @/lib/geo/postgis for writes.
  geometry        Unsupported("geometry(Point, 4326)")?
  /// Full-text search vector (PostgreSQL tsvector) — used for ts_rank and ts_query searches
  searchVector    Unsupported("tsvector")?
  verified        Boolean                               @default(false)
  geoTrust        Boolean                               @default(false)
  geoTrustLevel   String? // standard, expert, elite
  premium         Boolean                               @default(false)
  status          PropertyStatus                        @default(draft)
  views           Int                                   @default(0)
  favorites       Int                                   @default(0)
  agentId         String
  investmentScore Int? // 0-100 score investissement IA
  walkScore       Float? // 0-100 walkability score
  hasVR           Boolean                               @default(false)
  hasDroneView    Boolean                               @default(false)
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt
  /// RAG embedding vector (pgvector, 384 dimensions) — used for semantic search in Rebecca AI.
  /// Generated by @/lib/rag/embedder.ts. See CDC §8.1.2.
  embedding       Unsupported("vector(384)")?

  owner              User                 @relation(fields: [agentId], references: [id])
  transactionRecords Transaction[]
  propertyImages     PropertyImage[]
  virtualTours       VirtualTour[]
  legalDocs          PropertyLegalDoc[]
  geoInspections     GeoInspection[]
  geometerMissions   GeometerMission[]    @relation("PropertyMissions")
  favorites_rel      Favorite[]
  comparisons        PropertyComparison[] @relation("PropertyA")
  comparisons2       PropertyComparison[] @relation("PropertyB")
  appointments       Appointment[] // P2.9 — property visits
  propertyViews      PropertyView[] // audit-11 — listing view analytics

  deletedAt DateTime?

  @@index([country, status, createdAt]) // P2.3 — most common public query
  @@index([agentId, status]) // P2.3 — agent dashboard
  @@index([type, status]) // P2.3 — filter by type (was propertyType)
  @@index([price]) // P2.3 — price range queries
  @@index([city, status]) // P2.3 — city filter
  @@index([agentId], map: "Property_agentId_idx")
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([propertyId], map: "PropertyImage_propertyId_idx")
  @@map("property_images")
}

model VirtualTour {
  id           String   @id @default(cuid())
  propertyId   String
  tourType     String // matterport, 360_photo, drone, video
  url          String
  thumbnailUrl String?
  duration     Int? // seconds for video
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([propertyId], map: "VirtualTour_propertyId_idx")
  @@map("virtual_tours")
}

model PropertyLegalDoc {
  id              String   @id @default(cuid())
  propertyId      String
  docType         String // titre_foncier, acd, permis_construire, decision_parcelle, lettre_attribution, arrete_concession, puh, acte_cession, certificat_propriete_andf
  docUrl          String
  ocrValid        Boolean  @default(false)
  ocrResult       Json?
  aiScore         Float? // 0-100 AI validation
  status          String   @default("pending") // pending, ai_validated, human_validated, rejected
  country         String // BJ, CI, BF, TG — determines required docs
  rejectionReason String?
  uploadedAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([propertyId], map: "PropertyLegalDoc_propertyId_idx")
  @@map("property_legal_docs")
}

model PropertyComparison {
  id          String   @id @default(cuid())
  userId      String
  propertyAId String
  propertyBId String
  propertyCId String? // optional 3rd property
  propertyDId String? // optional 4th property
  propertyEId String? // optional 5th property
  createdAt   DateTime @default(now())

  propertyA Property @relation("PropertyA", fields: [propertyAId], references: [id])
  propertyB Property @relation("PropertyB", fields: [propertyBId], references: [id])

  @@map("property_comparisons")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId], map: "Favorite_userId_idx")
  @@map("favorites")
}

// ============ NOTARIES ============

model Notary {
  id                 String    @id @default(cuid())
  userId             String    @unique
  licenseNumber      String    @unique
  chamberName        String? // Chambre Nationale des Notaires
  specialty          String? // droit_foncier, succession, baux, etc.
  certificationLevel String    @default("standard") // standard, expert, elite
  country            String    @default("BJ") // BJ, CI, BF, TG — pays d'exercice
  zone               String? // zone d'intervention
  available          Boolean   @default(true)
  rating             Float     @default(0)
  missions           Int       @default(0)
  subscriptionTier   String? // gratuit, pro, elite
  subscriptionExpiry DateTime?
  conventionSigned   Boolean   @default(false)
  conventionUrl      String?
  certified          Boolean   @default(false)
  certifiedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@map("notaries")
}

// ============ TRANSACTIONS & ESCROW ============

model Transaction {
  id               String            @id @default(cuid())
  propertyId       String
  buyerId          String
  sellerId         String
  amount           Float
  commission       Decimal           @default(0) @db.Decimal(19, 4)
  currency         String            @default("XOF")
  country          String            @default("BJ") // BJ, CI, BF, TG — pays de la transaction
  status           TransactionStatus @default(CREATED)
  escrowReference  String?
  paymentProvider  String?
  paymentRef       String?
  conditions       Json?
  notaryId         String?
  geometerId       String?
  disputeReason    String?
  escrowFundedAt   DateTime?
  escrowReleasedAt DateTime?
  notaryAssignedAt DateTime?
  deedSignedAt     DateTime?
  andfRegisteredAt DateTime?
  ledgerEntries    Json?
  commissionRate   Decimal?          @db.Decimal(5, 4) // 2-5% selon montant
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  property         Property              @relation(fields: [propertyId], references: [id])
  buyer            User                  @relation(fields: [buyerId], references: [id])
  escrowAccount    EscrowAccount?
  timelineEvents   TransactionTimeline[]
  notarySignatures NotarySignature[] // P2.2 — inverse relation
  disputes         Dispute[] // P2.2 — inverse relation

  deletedAt DateTime?

  @@index([country, status, createdAt]) // P2.3 — admin transaction list
  @@index([buyerId, status]) // P2.3 — buyer dashboard
  @@index([sellerId, status]) // P2.3 — seller dashboard
  @@index([status, createdAt]) // P2.3 — admin queue
  @@index([propertyId], map: "Transaction_propertyId_idx")
  @@map("transactions")
}

model EscrowAccount {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  balance        Decimal     @default(0) @db.Decimal(19, 4)
  heldAmount     Decimal     @default(0) @db.Decimal(19, 4)
  releasedAmount Decimal     @default(0) @db.Decimal(19, 4)
  refundedAmount Decimal     @default(0) @db.Decimal(19, 4)
  currency       String      @default("XOF")
  status         EscrowState @default(EMPTY)
  fundedAt       DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transaction Transaction    @relation(fields: [transactionId], references: [id])
  ledger      EscrowLedger[]

  deletedAt DateTime?

  @@index([transactionId], map: "EscrowAccount_transactionId_idx")
  @@map("escrow_accounts")
}

model EscrowLedger {
  id              String   @id @default(cuid())
  escrowAccountId String
  entryType       String // CREDIT, DEBIT, HOLD, RELEASE, REFUND, COMMISSION
  amount          Float
  balanceAfter    Float
  currency        String   @default("XOF")
  reference       String?
  providerRef     String?
  metadata        Json?
  createdAt       DateTime @default(now())

  escrowAccount EscrowAccount @relation(fields: [escrowAccountId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([escrowAccountId], map: "EscrowLedger_escrowAccountId_idx")
  @@map("escrow_ledger")
}

model TransactionTimeline {
  id            String   @id @default(cuid())
  transactionId String
  fromStatus    String
  toStatus      String
  actorType     String // system, buyer, seller, notary, geometer, admin
  actorId       String?
  description   String
  metadata      Json?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId], map: "TransactionTimeline_transactionId_idx")
  @@map("transaction_timeline")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  country      String?
  type         String // deposit, withdrawal, escrow_fund, escrow_release, escrow_refund, commission, payout, subscription, academy_payment
  amount       Float
  balanceAfter Float
  currency     String   @default("XOF")
  status       String   @default("pending") // pending, completed, failed
  reference    String?
  providerRef  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([userId, createdAt]) // P2.3 — wallet history
  @@index([status, createdAt]) // P2.3 — pending payouts queue
  @@index([userId], map: "WalletTransaction_userId_idx")
  @@map("wallet_transactions")
}

// ============ AGENT LISTINGS ============

model AgentListing {
  id         String   @id @default(cuid())
  agentId    String
  propertyId String
  status     String   @default("active")
  boostLevel Decimal  @default(1.0) @db.Decimal(5, 4) // 1.0, 1.5, 2.5, 4.0 based on premium tier
  views      Int      @default(0)
  contacts   Int      @default(0)
  createdAt  DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id])

  @@index([propertyId], map: "AgentListing_propertyId_idx")
  @@map("agent_listings")
}

// ============ REVIEWS ============

model Review {
  id          String    @id @default(cuid())
  reviewerId  String
  targetId    String
  targetType  String // agent, artisan, property, geometer, notary, hotel, course
  country     String? // BJ, CI, BF, TG
  rating      Int // 1-5
  subRatings  Json?
  comment     String?
  verified    Boolean   @default(false)
  response    String? // owner response
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reviewer User @relation(fields: [reviewerId], references: [id])

  @@index([targetType, targetId], map: "Review_target_idx")
  @@map("reviews")
}

// ============ COURSES & ACADEMY ============

model Course {
  id                  String   @id @default(cuid())
  title               String
  slug                String?  @unique
  category            String // immobilier, droit_foncier, investissement, construction, finance, certification
  country             String   @default("BJ") // BJ, CI, BF, TG — marché cible
  instructorId        String
  instructor          String
  description         String?
  duration            String
  price               Decimal  @default(0) @db.Decimal(19, 4)
  currency            String   @default("XOF")
  level               String   @default("debutant") // debutant, intermediaire, avance, expert
  certificate         Boolean  @default(false)
  certificateTemplate String?
  rating              Float    @default(0)
  students            Int      @default(0)
  image               String?
  videoUrl            String?
  published           Boolean  @default(false)
  status              String   @default("draft") // draft, published, archived
  modules             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  enrollments      CourseEnrollment[]
  quizzes          Quiz[]
  certificates_rel Certificate[]

  /// RAG embedding vector (pgvector, 384 dimensions) — for Academy semantic search.
  embedding Unsupported("vector(384)")?

  deletedAt DateTime?

  @@map("courses")
}

model CourseEnrollment {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  progress         Float     @default(0)
  completed        Boolean   @default(false)
  certificateId    String?
  certificateUrl   String?
  completedModules Json?
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

// ============ COMMUNITY ============

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String?
  category  String // discussion, question, success_story, market_analysis, legal, event, investment
  country   String?
  replies   Int      @default(0)
  views     Int      @default(0)
  likes     Int      @default(0)
  pinned    Boolean  @default(false)
  tags      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User             @relation(fields: [authorId], references: [id])
  replies_rel CommunityReply[]
  likes_rel   PostLike[]

  deletedAt DateTime?

  @@index([authorId], map: "CommunityPost_authorId_idx")
  @@map("community_posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model CommunityReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([postId], map: "CommunityReply_postId_idx")
  @@map("community_replies")
}

model CommunityGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  description String?
  type        String // investisseurs, agents, artisans, ville, pays, theme
  country     String?
  city        String?
  members     Int      @default(0)
  isPrivate   Boolean  @default(false)
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships GroupMembership[]

  deletedAt DateTime?

  @@map("community_groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // member, moderator, admin
  joinedAt DateTime @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model CommunityEvent {
  id           String    @id @default(cuid())
  title        String
  description  String?
  organizerId  String
  groupId      String?
  eventType    String // meetup, webinar, formation, visite
  country      String? // BJ, CI, BF, TG
  city         String?
  venue        String?
  eventDate    DateTime
  endDate      DateTime?
  isVirtual    Boolean   @default(false)
  meetingUrl   String?
  maxAttendees Int?
  attendees    Int       @default(0)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  registrations EventRegistration[]

  deletedAt DateTime?

  @@map("community_events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // transaction, message, alert, system, promotion, community, rebecca, certification, profile, premium, security
  category  String // profile, annonces, transactions, market_alerts, rebecca, community, formations, certification, premium, security
  country   String? // BJ, CI, BF, TG — pays concerné
  title     String
  message   String
  read      Boolean   @default(false)
  actionUrl String?
  actorId   String? // who triggered this notification
  actorName String?
  metadata  Json?
  channels  Json?
  sentVia   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([userId, read, createdAt]) // P2.3 — unread notification badge
  @@index([userId, category, createdAt]) // P2.3 — notification filter by category
  @@index([country, createdAt]) // P2.3 — tenant-scoped broadcast
  @@index([userId, read], map: "Notification_user_read_idx")
  @@map("notifications")
}

