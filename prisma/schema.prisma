// ============ AFRIPOINTS ============

model AfriPointTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String // earn, spend
  action       String // post_created, quiz_passed, course_completed, boost_listing_7d, etc.
  points       Int
  balanceAfter Int
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("afripoint_transactions")
}

// ============ AMBASSADOR PROGRAM ============

model Ambassador {
  id             String    @id @default(cuid())
  userId         String    @unique
  tier           String    @default("bronze") // bronze, silver, gold
  referralCode   String    @unique
  referralLink   String?
  commissionRate Decimal   @default(0.05) @db.Decimal(5, 4)
  totalReferrals Int       @default(0)
  totalEarnings  Decimal   @default(0) @db.Decimal(19, 4)
  status         String    @default("active") // active, pending, suspended
  appliedAt      DateTime  @default(now())
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id])
  commissions AmbassadorCommission[]

  deletedAt DateTime?

  @@map("ambassadors")
}

model AmbassadorCommission {
  id             String    @id @default(cuid())
  ambassadorId   String
  referredUserId String
  transactionId  String?
  amount         Float
  commissionRate Float
  status         String    @default("pending") // pending, paid, cancelled
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  ambassador Ambassador @relation(fields: [ambassadorId], references: [id])

  @@map("ambassador_commissions")
}

// ============ FOLLOWERS ============

model Follower {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("followers")
}

// ============ SHORT-TERM RENTALS (Location Courte Durée — Airbnb Model) ============

model ShortTermRental {
  id                   String   @id @default(cuid())
  hostId               String
  title                String
  slug                 String?  @unique
  description          String?
  propertyType         String // appartement, villa, studio, chambre, maison, loft, bungalow
  city                 String
  country              String
  quartier             String?
  address              String?
  lat                  Float?
  lng                  Float?
  images               Json?
  pricePerNight        Float
  weeklyPrice          Float?
  monthlyPrice         Float?
  currency             String   @default("XOF")
  maxGuests            Int      @default(2)
  bedrooms             Int      @default(1)
  bathrooms            Int      @default(1)
  beds                 Int      @default(1)
  amenities            Json?
  houseRules           Json?
  instantBooking       Boolean  @default(false)
  rating               Float    @default(0)
  reviewCount          Int      @default(0)
  views                Int      @default(0)
  otaRefs              Json?
  otaSyncStatus        Json?
  hostVerified         Boolean  @default(false)
  hostIdentityVerified Boolean  @default(false)
  status               String   @default("active") // active, inactive, pending_review, suspended
  minStayNights        Int      @default(1)
  maxStayNights        Int?
  cancellationPolicy   String   @default("flexible") // flexible, moderate, strict
  cleaningFee          Decimal  @default(0) @db.Decimal(19, 4)
  securityDeposit      Decimal  @default(0) @db.Decimal(19, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings     ShortTermRentalBooking[]
  availability ShortTermRentalAvailability[]
  pricingRules ShortTermRentalPricingRule[]
  reviews_str  ShortTermRentalReview[]

  deletedAt DateTime?

  @@map("short_term_rentals")
}

model ShortTermRentalAvailability {
  id            String   @id @default(cuid())
  rentalId      String
  date          DateTime
  status        String   @default("AVAILABLE") // AVAILABLE, BOOKED, BLOCKED, MAINTENANCE
  priceOverride Float?
  currency      String   @default("XOF")
  source        String   @default("manual") // manual, ota_booking, airbnb, booking_com
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rental ShortTermRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@unique([rentalId, date])
  @@map("short_term_rental_availability")
}

model ShortTermRentalPricingRule {
  id         String    @id @default(cuid())
  rentalId   String
  name       String
  period     String // low_season, high_season, event, holiday, weekend, custom
  multiplier Decimal   @default(1.0) @db.Decimal(5, 4)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  rental ShortTermRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("short_term_rental_pricing_rules")
}

model ShortTermRentalBooking {
  id                 String    @id @default(cuid())
  bookingRef         String?   @unique
  rentalId           String
  userId             String
  checkIn            DateTime
  checkOut           DateTime
  guests             Int       @default(1)
  nights             Int
  pricePerNight      Float
  cleaningFee        Decimal   @default(0) @db.Decimal(19, 4)
  securityDeposit    Decimal   @default(0) @db.Decimal(19, 4)
  totalPrice         Float
  serviceFee         Decimal   @default(0) @db.Decimal(19, 4)
  currency           String    @default("XOF")
  bookingType        String    @default("instant") // instant, request
  sourceChannel      String    @default("direct") // direct, airbnb, booking_com
  status             String    @default("pending") // pending, confirmed, checked_in, completed, cancelled, declined
  paymentRef         String?
  paymentProvider    String? // fedapay, stripe
  specialRequests    String?
  hostResponse       String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  rental ShortTermRental        @relation(fields: [rentalId], references: [id])
  user   User                   @relation(fields: [userId], references: [id])
  review ShortTermRentalReview?

  deletedAt DateTime?

  @@index([rentalId, checkIn], map: "ShortTermRentalBooking_checkIn_idx")
  @@map("short_term_rental_bookings")
}

model ShortTermRentalReview {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  rentalId      String
  userId        String
  cleanliness   Int? // 1-5
  accuracy      Int? // 1-5
  communication Int? // 1-5
  location      Int? // 1-5
  checkIn       Int? // 1-5
  value         Int? // 1-5
  overall       Int // 1-5
  comment       String?
  hostResponse  String?
  respondedAt   DateTime?
  status        String    @default("published") // pending_moderation, published, hidden
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking ShortTermRentalBooking @relation(fields: [bookingId], references: [id])
  rental  ShortTermRental        @relation(fields: [rentalId], references: [id])

  @@map("short_term_rental_reviews")
}

// ============ SCHEDULED PAYOUTS (J+1 Engine) ============

model ScheduledPayout {
  id              String    @id @default(cuid())
  transactionId   String
  recipientId     String
  amount          Float
  currency        String    @default("XOF")
  method          String // mobile_money, bank_transfer, fedapay
  destination     String // phone number or bank account ref
  country         String    @default("BJ") // BJ, CI, BF, TG
  status          String    @default("scheduled") // scheduled, processing, completed, failed
  scheduledAt     DateTime // when the payout should be executed
  processedAt     DateTime?
  providerRef     String?
  confirmationRef String?
  failureReason   String?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([recipientId])
  @@map("scheduled_payouts")
}

// ============ AUDIT LOG ============

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // who performed the action (null for system)
  actorRole  String? // role at time of action
  action     String // e.g. "user.update_role", "kyc.validate", "property.publish", "escrow.release"
  targetType String? // "user", "property", "kyc_document", "transaction", "escrow", "subscription", "course"
  targetId   String? // ID of the affected entity
  country    String? // BJ, CI, BF, TG, SN — tenant scope
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([country])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============ WEBHOOK EVENT (P2.1 — idempotency for Stripe/FedaPay webhooks) ============

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String // "stripe" | "fedapay" | "booking_com" | "expedia"
  externalEventId String    @unique // provider's event ID (e.g. evt_xxx from Stripe)
  eventType       String // e.g. "payment_intent.succeeded", "payout.paid"
  payload         String // raw JSON body (for audit/debugging)
  signature       String? // signature header value (for verification audit)
  status          String    @default("received") // "received" | "processed" | "failed" | "ignored"
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  @@index([provider, externalEventId])
  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

// ============ APPOINTMENT (P2.9 — persist appointments) ============

model Appointment {
  id          String   @id @default(cuid())
  propertyId  String
  userId      String // the visitor (buyer/tenant)
  agentId     String? // the agent/owner (nullable for direct-to-owner)
  scheduledAt DateTime
  duration    Int      @default(60) // minutes
  status      String   @default("pending") // "pending" | "confirmed" | "cancelled" | "completed" | "no_show"
  notes       String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([agentId, scheduledAt])
  @@index([status])
  @@index([propertyId], map: "Appointment_propertyId_idx")
  @@map("appointments")
}

// ============ NOTARY SIGNATURE (P2.2 — dedicated table for notarial signatures) ============
// Previously stored as JSON in TransactionTimeline.metadata. Promoted to a first-class
// model so signatures can be queried, audited, and revoked independently of the timeline.
// Schema migration: data backfill from TransactionTimeline.metadata will be performed in
// a subsequent application-level migration session.

model NotarySignature {
  id            String   @id @default(cuid())
  requestId     String   @unique // signature request identifier
  transactionId String
  documentId    String // deed/document being signed
  signerId      String // user signing
  signerRole    String // buyer, seller, notary, witness
  signatureData String // base64 signature image or cryptographic signature
  ipAddress     String?
  userAgent     String?
  isValid       Boolean  @default(true)
  signedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  signer      User        @relation(fields: [signerId], references: [id])

  @@index([transactionId])
  @@index([signerId])
  @@index([requestId])
  @@map("notary_signatures")
}

// ============ DISPUTE (P2.2 — dedicated table for transaction disputes) ============
// Previously stored as JSON in TransactionTimeline.metadata. Promoted to a first-class
// model so disputes can be tracked, mediated, and resolved with proper audit trail.
// Schema migration: data backfill from TransactionTimeline.metadata will be performed in
// a subsequent application-level migration session.

model Dispute {
  id               String    @id @default(cuid())
  transactionId    String
  initiatedBy      String // userId who opened the dispute
  reason           String // item_not_as_described, payment_issue, fraud_suspected, other
  description      String
  status           String    @default("open") // open, evidence_collection, mediation, resolved, rejected
  evidenceUrls     Json?
  mediatorId       String? // admin/notary assigned
  mediatorNotes    String?
  resolution       String? // refund, partial_refund, release_to_seller, escalation
  resolvedAt       DateTime?
  resolutionAmount Decimal?  @db.Decimal(19, 4) // amount if partial refund
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  initiator   User        @relation(fields: [initiatedBy], references: [id])

  @@index([transactionId])
  @@index([status, createdAt])
  @@index([initiatedBy])
  @@map("disputes")
}

// ============ CONTENT_ITEM (audit-9) ============

model ContentItem {
  id        String   @id @default(cuid())
  section   String
  key       String
  label     String
  value     String   @db.Text
  country   String   @default("*")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([section, key, country])
  @@index([section])
  @@index([country])
  @@map("content_items")
}

// ============ PROPERTY_VIEW (audit-11 — replaces in-memory listing-views stub) ============
// CDC §5.9.1: Track profile/listing views with visitor metadata for analytics.
// Previously src/lib/analytics/listing-views.ts used an in-memory array that was
// lost on every serverless cold start. This model persists views to PostgreSQL.

model PropertyView {
  id          String   @id @default(cuid())
  propertyId  String
  viewerId    String?  // null = anonymous viewer
  isAnonymous Boolean  @default(false)
  source      String   @default("direct") // search, direct, social, email, notification, other
  country     String?
  city        String?
  device      String   @default("desktop") // mobile, desktop, tablet
  viewedAt    DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, viewedAt])
  @@index([viewerId, viewedAt])
  @@index([propertyId, isAnonymous])
  @@map("property_views")
}
